<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ModManager.PluginContracts</RootNamespace>
    <AssemblyName>Kroste.ModManager.PluginContracts</AssemblyName>

    <!-- NuGet-Package Metadaten (wird via `dotnet pack` erstellt und via Release-Workflow
         auf GitHub Packages veröffentlicht). Plugin-Autoren referenzieren via
         PackageReference und pinnen MinHostVersion per SemVer. -->
    <PackageId>Kroste.ModManager.PluginContracts</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Kroste ModManager Plugin Contracts</Title>
    <Description>Interfaces und DTOs für Game-Plugins des Kroste ModManagers.</Description>
    <PackageProjectUrl>https://github.com/Kroste/Mod-Manager</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>modmanager;plugin;kroste;avalonia</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="NLog" />
  </ItemGroup>
</Project>
