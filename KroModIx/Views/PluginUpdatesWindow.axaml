<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:KroModIx.Views"
        xmlns:controls="using:KroModIx.Controls"
        xmlns:vm="using:KroModIx.ViewModels"
        x:Class="KroModIx.Views.PluginUpdatesWindow"
        x:DataType="vm:PluginUpdatesViewModel"
        Width="720" Height="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Title="Plugin-Manager"
        Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="Plugin-Manager" />

        <Border Padding="20">
            <DockPanel>

                <!-- Restart-Hint immer unten sichtbar wenn eine Install/Uninstall-Aktion lief -->
                <Border DockPanel.Dock="Bottom"
                        Background="#5A2A19"
                        BorderBrush="#8A3F27"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,12,0,0"
                        IsVisible="{Binding RestartHinted}">
                    <TextBlock Text="⚠  Bitte die App neu starten, damit die Änderungen aktiv werden. Die geladenen Assemblies können im laufenden Prozess nicht ersetzt oder entfernt werden."
                               TextWrapping="Wrap" />
                </Border>

                <ScrollViewer>
                    <StackPanel Spacing="18">

                        <!-- Sektion 1: Verfügbare Updates -->
                        <TextBlock Text="VERFÜGBARE UPDATES" Classes="section-label" />
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="accent" Content="🔄  Jetzt prüfen"
                                            Command="{Binding CheckNowCommand}" />
                                    <TextBlock Text="{Binding StatusMessage}"
                                               Classes="secondary" VerticalAlignment="Center" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:UpdateRow">
                                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4"
                                                  ColumnSpacing="10">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding VersionLabel}"
                                                               Classes="muted" FontSize="11" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Status}"
                                                           Classes="secondary"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="2"
                                                        Classes="accent"
                                                        Content="⬇  Installieren"
                                                        Command="{Binding $parent[ItemsControl].((vm:PluginUpdatesViewModel)DataContext).InstallCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Sektion 2: Installierte Plugins -->
                        <TextBlock Text="INSTALLIERTE PLUGINS" Classes="section-label" Margin="0,8,0,0" />
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding InstalledStatus}" Classes="muted" FontSize="11" />
                                <ItemsControl ItemsSource="{Binding Installed}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InstalledPluginRow">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,4"
                                                  ColumnSpacing="10">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                        <Border CornerRadius="10" Padding="8,1"
                                                                Background="{DynamicResource KrosteSuccessBrush}"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding IsLoaded}">
                                                            <TextBlock Text="geladen" FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="White" />
                                                        </Border>
                                                        <Border CornerRadius="10" Padding="8,1"
                                                                Background="{DynamicResource KrosteAccentSoftBrush}"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding !IsUserInstalled}">
                                                            <TextBlock Text="bundled" FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource KrosteSecondaryTextBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding VersionLabel}"
                                                               Classes="muted" FontSize="11" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Status}"
                                                           Classes="secondary"
                                                           VerticalAlignment="Center" />
                                                <!-- Nur User-installierte Plugins können deinstalliert werden.
                                                     Bundled-Plugins liegen neben der Exe (read-only, sinnvoll
                                                     nur beim Windows-Installer/AppImage). -->
                                                <Button Grid.Column="3"
                                                        Classes="danger"
                                                        Content="🗑  Deinstallieren"
                                                        IsVisible="{Binding IsUserInstalled}"
                                                        Command="{Binding $parent[ItemsControl].((vm:PluginUpdatesViewModel)DataContext).UninstallCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</views:ChromeWindow>
