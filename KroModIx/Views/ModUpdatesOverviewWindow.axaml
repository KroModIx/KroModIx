<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:KroModIx.Views"
        xmlns:controls="using:KroModIx.Controls"
        xmlns:vm="using:KroModIx.ViewModels"
        x:Class="KroModIx.Views.ModUpdatesOverviewWindow"
        x:DataType="vm:ModUpdatesOverviewViewModel"
        Width="720" Height="560" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Title="Mod-Updates"
        Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="🎮  Mod-Updates" />

        <Border Padding="20">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding StatusMessage}"
                           Classes="secondary"
                           Margin="0,0,0,14" />

                <Border Classes="card"
                        IsVisible="{Binding !HasRows}"
                        Padding="24">
                    <TextBlock Text="Aktuell sind keine Mod-Updates gemeldet. Plugins pruefen im Hintergrund alle 60 Sekunden — ausserdem beim Oeffnen ihres Katalog-Tabs."
                               Classes="muted"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                </Border>

                <ScrollViewer IsVisible="{Binding HasRows}">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameEntry">
                                <Border Classes="card" Margin="0,0,0,10" Padding="12">
                                    <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="14">
                                        <!-- Cover 64x86 (Steam-Portrait-Ratio 2:3, kompakter als Sidebar) -->
                                        <Border Grid.Column="0"
                                                Width="64" Height="86"
                                                CornerRadius="4"
                                                ClipToBounds="True"
                                                Background="{DynamicResource KrosteSurfaceAltBrush}">
                                            <Image Source="{Binding Cover}"
                                                   Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border CornerRadius="10" Padding="8,2"
                                                        Background="{DynamicResource KrosteSuccessBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="White">
                                                        <Run Text="↑" />
                                                        <Run Text="{Binding PendingUpdateCount}" />
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding UpdateBadgeTooltip}"
                                                           Classes="secondary"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Classes="accent"
                                                Content="🎮  Zum Spiel"
                                                VerticalAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].((vm:ModUpdatesOverviewViewModel)DataContext).JumpToCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</views:ChromeWindow>
