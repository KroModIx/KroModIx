<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:KroModIx.Views"
        xmlns:controls="using:KroModIx.Controls"
        xmlns:vm="using:KroModIx.ViewModels"
        x:Class="KroModIx.Views.AddFolderCollectionDialog"
        x:DataType="vm:AddFolderCollectionDialogViewModel"
        Width="620" Height="500" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Title="Ordner mit Spielen scannen"
        Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="🎮 Ordner mit Spielen scannen" />

        <Border Padding="20">
            <StackPanel Spacing="14">

                <TextBlock TextWrapping="Wrap" Classes="secondary">
                    Wähle einen Root-Ordner mit deinen Spielen (z. B. deine Ren'Py-Sammlung).
                    KroModIx scannt den Inhalt (bis 2 Ebenen tief), erkennt die Engine
                    (aktuell nur Ren'Py) und legt pro gefundenem Spiel eine eigene
                    Sidebar-Kachel an, die vom passenden Plugin übernommen wird.
                </TextBlock>

                <StackPanel Spacing="6">
                    <TextBlock Text="Root-Ordner" Classes="section-label" />
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0" Text="{Binding RootDir, Mode=TwoWay}"
                                 PlaceholderText="/pfad/zur/sammlung" />
                        <Button Grid.Column="1" x:Name="PickDirButton" Margin="8,0,0,0"
                                Content="Wählen…" />
                        <Button Grid.Column="2" Classes="accent" Margin="8,0,0,0"
                                Content="🔍 Scannen"
                                Command="{Binding ScanCommand}" />
                    </Grid>
                </StackPanel>

                <Border Padding="12" CornerRadius="6"
                        Background="{DynamicResource KrosteSurfaceBrush}"
                        IsVisible="{Binding HasScanned}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Samples}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=• {0}}" Classes="muted" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource KrosteDangerBrush}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Right">
                    <Button Content="Abbrechen" Command="{Binding CancelCommand}" MinWidth="100" />
                    <Button Classes="accent" Content="Spiele importieren"
                            Command="{Binding ConfirmCommand}" MinWidth="180" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DockPanel>
</views:ChromeWindow>
