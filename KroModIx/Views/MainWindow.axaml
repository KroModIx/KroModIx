<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:KroModIx.Views"
        xmlns:controls="using:KroModIx.Controls"
        xmlns:loc="using:KroModIx.Localization"
        xmlns:vm="using:KroModIx.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        x:Class="KroModIx.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1250" Height="800" MinWidth="960" MinHeight="620"
        Title="{loc:Tr App_Title}"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr App_Title}" />

        <!-- Header: App-Titel + Untertitel + globale Aktionen -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource KrosteTitleBarBrush}"
                BorderBrush="{DynamicResource KrosteBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{loc:Tr App_Title}" Classes="h1" />
                    <TextBlock Text="{loc:Tr Main_Header_Subtitle}" Classes="muted" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <!-- KI-Chip: zeigt Provider + aktives Modell, Klick öffnet Settings.
                         Unsichtbar wenn Provider = None (initialer Zustand). -->
                    <Button Name="AiChipButton"
                            Classes="ghost"
                            Content="{Binding AiChipLabel}"
                            IsVisible="{Binding HasAiChip}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="{Binding AiChipTooltip}" />
                    <!-- Update-Badge: accent-Style wenn Plugin-Updates verfügbar,
                         sonst ghost mit „Plugins verwalten" — gleicher Command,
                         öffnet den Plugin-Manager (Updates + installierte Plugins). -->
                    <Button Name="UpdateBadgeButton"
                            Classes="accent"
                            Content="{Binding UpdateBadgeText}"
                            IsVisible="{Binding HasAvailableUpdates}"
                            Command="{Binding OpenPluginUpdatesCommand}"
                            ToolTip.Tip="Plugin-Updates verfügbar" />
                    <Button Name="OpenPluginManagerButton"
                            Classes="ghost"
                            Content="🧩 Plugins"
                            IsVisible="{Binding !HasAvailableUpdates}"
                            Command="{Binding OpenPluginUpdatesCommand}"
                            ToolTip.Tip="Installierte Plugins verwalten (installieren, updaten, deinstallieren)" />
                    <Button Name="OpenSettingsButton"
                            Classes="ghost"
                            Content="{loc:Tr Common_Settings}"
                            Command="{Binding OpenSettingsCommand}" />
                    <Button Name="OpenAboutButton"
                            Classes="ghost"
                            Content="{loc:Tr Common_About}"
                            Command="{Binding OpenAboutCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statusbar unten: StatusText links + Progress-Bar (indeterminate
             oder determinate) rechts. IProgressScope.Report vom Plugin
             füttert die Bar via StatusProgressCoordinator → ProgressXxx-
             Properties im VM. -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource KrosteTitleBarBrush}"
                BorderBrush="{DynamicResource KrosteBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,6">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           Classes="muted" FontSize="11"
                           VerticalAlignment="Center"
                           IsVisible="{Binding !ProgressIsActive}" />
                <TextBlock Grid.Column="0" Classes="muted" FontSize="11"
                           VerticalAlignment="Center"
                           IsVisible="{Binding ProgressIsActive}">
                    <Run Text="{Binding ProgressTitle}" />
                    <Run Text=" · " />
                    <Run Text="{Binding ProgressMessage}" />
                </TextBlock>
                <ProgressBar Grid.Column="1" IsIndeterminate="True"
                             Width="140" Margin="12,0"
                             VerticalAlignment="Center"
                             IsVisible="{Binding ProgressIndeterminate}" />
                <ProgressBar Grid.Column="2" Minimum="0" Maximum="1"
                             Value="{Binding ProgressFraction, FallbackValue=0}"
                             Width="140" Margin="12,0"
                             VerticalAlignment="Center"
                             IsVisible="{Binding HasProgressFraction}" />
            </Grid>
        </Border>

        <!-- Body: Sidebar + Content -->
        <Grid ColumnDefinitions="300,*">

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource KrosteTitleBarBrush}"
                    BorderBrush="{DynamicResource KrosteBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Sidebar-Header: Suche + Filter + Add-Button -->
                    <StackPanel DockPanel.Dock="Top" Margin="10,10,10,6" Spacing="8">
                        <TextBlock Text="GAMES" Classes="section-label" Margin="0" />
                        <TextBox Name="SidebarSearchBox"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 PlaceholderText="{loc:Tr Main_Sidebar_Search_Placeholder}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <CheckBox Name="OnlyWithPluginCheckBox"
                                      Grid.Column="0"
                                      Content="{loc:Tr Main_Sidebar_FilterOnlyWithPlugin}"
                                      IsChecked="{Binding OnlyWithPlugin, Mode=TwoWay}"
                                      Foreground="{DynamicResource KrosteSecondaryTextBrush}"
                                      FontSize="12" />
                            <Button Name="AddGameButton"
                                    Grid.Column="1" Classes="ghost" FontSize="12"
                                    Content="{loc:Tr Main_Sidebar_AddGame}"
                                    Command="{Binding AddGameCommand}" />
                        </Grid>
                    </StackPanel>

                    <!-- Kachel-Liste. DoubleTapped auf ListBoxItem startet
                         das gerade angeklickte Spiel — Steam-Library-Verhalten.
                         Einfach-Klick selektiert nur (Content-Bereich rendert
                         die Plugin-Tabs bzw. Install-Karte). -->
                    <ListBox Name="SidebarGamesListBox"
                             ItemsSource="{Binding VisibleGames}"
                             SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                             DoubleTapped="OnGameDoubleTapped"
                             Background="Transparent" BorderThickness="0"
                             Padding="6,4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <!-- Kachel-Layout: großes Cover mit Titel darunter -->
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="4" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#2A2F36" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource KrosteAccentSoftBrush}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameEntry">
                                <Border Padding="6" CornerRadius="4">
                                    <StackPanel Spacing="6">
                                        <!-- Cover mit Stern-Overlay -->
                                        <Panel Width="176" Height="238">
                                            <!-- Platzhalter-Hintergrund für Spiele ohne Cover -->
                                            <Border Background="{DynamicResource KrosteSurfaceBrush}"
                                                    BorderBrush="{DynamicResource KrosteBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4" />
                                            <Image Source="{Binding Cover}"
                                                   Stretch="UniformToFill"
                                                   IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,176,238" RadiusX="4" RadiusY="4" />
                                                </Image.Clip>
                                            </Image>
                                            <!-- Fallback-Text bei fehlendem Cover -->
                                            <TextBlock Text="{Binding DisplayName}"
                                                       IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNull}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource KrosteMutedTextBrush}"
                                                       TextWrapping="Wrap" TextAlignment="Center"
                                                       Margin="12" />
                                            <!-- Stern-Overlay oben links: dunkler Halo + goldener Vordergrund,
                                                 damit er auch auf hellen Cover-Ecken sichtbar bleibt. -->
                                            <Border HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="4,4,0,0"
                                                    Padding="4,0"
                                                    CornerRadius="4"
                                                    Background="#B3000000"
                                                    IsVisible="{Binding StarSymbol, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{Binding StarSymbol}"
                                                           Foreground="{DynamicResource KrosteGoldBrush}"
                                                           FontSize="26"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </Panel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource KrosteTextBrush}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   MaxLines="2"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxWidth="180" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Border Grid.Column="1" Padding="20">
                <DockPanel>
                    <!-- Content-Header: Spielname + ▶ Starten. Nur sichtbar wenn
                         ein Spiel selektiert ist. Klick oder Sidebar-Doppelklick
                         starten das Spiel (LaunchSelectedGameCommand).
                         CanLaunchSelected disabled den Button wenn weder
                         Steam-AppId noch Executable-Pfad da sind. -->
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto"
                          Margin="0,0,0,14"
                          IsVisible="{Binding HasSelectedGame}">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedGame.DisplayName}"
                                   Classes="h1" FontSize="18"
                                   VerticalAlignment="Center" />
                        <Button Name="LaunchSelectedGameButton"
                                Grid.Column="1"
                                Classes="accent"
                                Content="▶  Spiel starten"
                                Command="{Binding LaunchSelectedGameCommand}"
                                IsEnabled="{Binding CanLaunchSelected}"
                                ToolTip.Tip="Doppelklick auf die Kachel in der Sidebar startet das Spiel ebenfalls" />
                    </Grid>

                    <Grid>
                    <!-- Placeholder wenn kein Plugin oder kein Spiel -->
                    <Border Classes="card-flat" Padding="24"
                            IsVisible="{Binding ShowContentPlaceholder}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <StackPanel Spacing="16"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="520">
                            <TextBlock Text="🎮"
                                       FontSize="48"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource KrosteMutedTextBrush}"
                                       Opacity="0.5" />
                            <TextBlock Text="{Binding ContentPlaceholderText}"
                                       Classes="secondary"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Tr Main_SelectGamePrompt}"
                                       IsVisible="{Binding !HasSelectedGame}"
                                       Classes="muted"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Install-Karte: Plugin verfügbar aber nicht installiert.
                         Bewusst KEIN DataContext-Wechsel am äußeren Border —
                         sonst würde IsVisible gegen InstallCardViewModel gebunden
                         (der hat kein ShowInstallCard) und die Bindung
                         schlüge fehl → Border bliebe unsichtbar.
                         DataContext-Wechsel erst am inneren StackPanel. -->
                    <Border Classes="card" Padding="24"
                            IsVisible="{Binding ShowInstallCard}"
                            MaxWidth="620"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <StackPanel Spacing="14" DataContext="{Binding InstallCard}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="☆"
                                           Foreground="{DynamicResource KrosteGoldBrush}"
                                           FontSize="24" VerticalAlignment="Center" />
                                <TextBlock Text="Plugin verfügbar" Classes="h1" FontSize="18"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding PluginTitle}" Classes="h2" />
                            <TextBlock Text="{Binding PluginAuthor, StringFormat='von {0}'}"
                                       Classes="muted" FontSize="12" />
                            <TextBlock Text="{Binding PluginDescription}"
                                       Classes="secondary" TextWrapping="Wrap" />
                            <Rectangle Classes="divider-h" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Classes="accent" Content="⬇  Installieren"
                                        Command="{Binding InstallCommand}"
                                        IsEnabled="{Binding !IsBusy}"
                                        MinWidth="160" />
                                <ProgressBar IsIndeterminate="True"
                                             IsVisible="{Binding IsBusy}"
                                             VerticalAlignment="Center"
                                             Width="180" />
                                <TextBlock Text="{Binding StatusMessage}"
                                           Classes="secondary"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Plugin-Tabs -->
                    <TabControl ItemsSource="{Binding PluginTabs}"
                                IsVisible="{Binding ShowPluginTabs}"
                                Background="Transparent" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</views:ChromeWindow>
