<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>KroModIx</RootNamespace>
    <AssemblyName>KroModIx</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/kromodix.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <None Update="nlog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KroModIx.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../KroModIx.Plugin.Contracts/KroModIx.Plugin.Contracts.csproj" />
  </ItemGroup>

  <!-- ASP.NET Core (Kestrel + Minimal-API) für die eingebaute REST-API.
       FrameworkReference statt PackageReference — kein NuGet nötig, das
       Runtime-Bundle ist im .NET-10-SDK enthalten. Publish zieht das Bundle
       via UseAppHost bei self-contained. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Microsoft.Extensions.DependencyInjection + Microsoft.Extensions.Http
         kommen via FrameworkReference Microsoft.AspNetCore.App (siehe unten)
         mit — separate PackageReferences würden NU1510-Fehler auslösen. -->
    <PackageReference Include="NLog" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
  </ItemGroup>
</Project>
