<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>KroModIx.Plugin.Contracts</RootNamespace>
    <AssemblyName>KroModIx.Plugin.Contracts</AssemblyName>

    <!-- NuGet-Package Metadaten (wird via `dotnet pack` erstellt und via Release-Workflow
         auf GitHub Packages veröffentlicht). Plugin-Autoren referenzieren via
         PackageReference und pinnen MinHostVersion per SemVer. -->
    <PackageId>KroModIx.Plugin.Contracts</PackageId>
    <IsPackable>true</IsPackable>
    <Title>KroModIx Plugin Contracts</Title>
    <Description>Interfaces und DTOs für Game-Plugins von KroModIx.</Description>
    <PackageProjectUrl>https://github.com/KroModIx/KroModIx</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>kromodix;modmanager;plugin;kroste;avalonia</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="NLog" />
  </ItemGroup>
</Project>
